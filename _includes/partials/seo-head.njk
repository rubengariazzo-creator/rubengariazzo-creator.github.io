{%- set canonicalUrl = site.url + page.url -%}
{%- set ogImage = socialImage or ("/" + thumbnail if thumbnail else "/assets/img/social-default.jpg") -%}
<title>{{ seoTitle or (title if title == site.name else title + " | " + site.name) }}</title>
<meta name="description" content="{{ description }}">
<meta name="author" content="{{ site.name }}">
{#- Bing Webmaster Tools ownership proof for ruben-gariazzo.fr: keep it. #}
<meta name="msvalidate.01" content="D75141866693B5341E7AFF422A65F9F7">
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
<link rel="canonical" href="{{ canonicalUrl }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ 'fr_FR' if lang == 'fr' else 'en_US' }}">
<meta property="og:title" content="{{ seoTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonicalUrl }}">
{%- if profilePage %}
<meta property="og:type" content="profile">
<meta property="profile:first_name" content="Ruben">
<meta property="profile:last_name" content="Gariazzo">
{%- else %}
<meta property="og:type" content="website">
{%- endif %}
<meta property="og:image" content="{{ site.url }}{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">

{%- if translationKey and collections.byTranslationKey[translationKey] %}
{%- for lang, url in collections.byTranslationKey[translationKey] %}
<link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ collections.byTranslationKey[translationKey].fr }}">
{%- endif %}

{#- Built by the structuredData filter (.eleventy.js) with JSON.stringify:
    a script tag's content isn't HTML-entity-decoded, so Nunjucks-escaped
    interpolation would leave literal "&#39;" inside the parsed JSON-LD. #}
<script type="application/ld+json">{{ { url: page.url, lang: lang, title: title, profile: profilePage, contact: contactPage, publications: publications } | structuredData(site) | safe }}</script>
