{%- set canonicalUrl = site.url + page.url -%}
{%- set ogImage = socialImage or ("/" + thumbnail if thumbnail else "/assets/img/social-default.jpg") -%}
<title>{{ title if title == site.name else title + " | " + site.name }}</title>
<meta name="description" content="{{ description }}">
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
<link rel="canonical" href="{{ canonicalUrl }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:type" content="website">
<meta property="og:image" content="{{ site.url }}{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">

{%- if translationKey and collections.byTranslationKey[translationKey] %}
{%- for lang, url in collections.byTranslationKey[translationKey] %}
<link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ collections.byTranslationKey[translationKey].fr }}">
{%- endif %}

{#- The whole object goes through the `json` filter in one call rather than
    interpolating each field into a hand-written JSON literal: a script tag's
    content isn't HTML-entity-decoded by the browser, so an apostrophe in e.g.
    alumniOf ("EPF - École d'ingénieurs") would render as the literal text
    "&#39;" inside the parsed JSON-LD instead of becoming a quote mark once
    Nunjucks' default auto-escaping got involved -- serializing server-side
    with JSON.stringify is the only way that's correct for every field,
    always, not just the ones that happen not to contain a quote today. #}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": site.name,
  "url": site.url,
  "jobTitle": site.jobTitle,
  "alumniOf": site.alumniOf,
  "description": site.bio,
  "knowsAbout": site.knowsAbout,
  "sameAs": site.sameAs
} | json | safe }}</script>
