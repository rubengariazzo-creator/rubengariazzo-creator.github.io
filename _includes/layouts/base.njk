<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <!-- script-src/connect-src include cdn.jsdelivr.net and wasm-unsafe-eval for
       the drone rescue game's Pyodide runtime (assets/js/drone-game.js):
       pyodide.js itself is loaded via a <script src>, then it fetches its own
       WASM binary and data files from the same CDN path at runtime (governed
       by connect-src, not script-src), and instantiating that WASM module
       needs 'wasm-unsafe-eval' -- CSP treats WebAssembly like eval() unless
       this narrower keyword is present, without ever allowing 'unsafe-eval'
       itself. Every other script/connection on the site stays 'self' only. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cdn.jsdelivr.net; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/assets/favicon/icon.svg" type="image/svg+xml">
  <!-- Preloads only the base-Latin subset (covers FR+EN body text, including
       accented characters -- U+0000-00FF) so it has a head start on the
       fallback-to-webfont swap `font-display: swap` performs; the Latin
       Extended subset is rarely hit by real content here and isn't worth
       spending critical-path bytes on preloading too. Caught via a Lighthouse
       mobile audit showing a real CLS regression (0.365) traced to this
       swap -- desktop/fast-network loads swap before layout is observed, so
       it only shows up once the font load is slow enough to matter. -->
  <link rel="preload" href="/assets/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  {%- include "partials/seo-head.njk" %}
</head>
<body data-category="{{ category }}" data-project-key="{{ translationKey }}">
  <div class="starfield" aria-hidden="true"></div>
  <a class="skip-link" href="#main">{{ 'Aller au contenu' if lang == 'fr' else 'Skip to content' }}</a>
  {%- include "partials/nav.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {%- include "partials/footer.njk" %}
  <script src="/assets/js/pointer.js" defer></script>
  <script src="/assets/js/cursor.js" defer></script>
  <script src="/assets/js/reveal-on-scroll.js" defer></script>
  <script src="/assets/js/smart-header.js" defer></script>
  <script src="/assets/js/magnetic-hover.js" defer></script>
  <script type="module" src="/assets/app-dist/page-entrance.js"></script>
</body>
</html>
