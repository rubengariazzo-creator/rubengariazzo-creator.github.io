---
layout: layouts/base.njk
---
<article class="page">
  {%- if heroBackground %}
  <div class="hero-gradient" data-gradient="{{ heroColors | join(',') if heroColors else '' }}" aria-hidden="true"></div>
  <script src="/assets/js/gradient-bg.js" defer></script>
  {%- endif %}
  {%- if heroLiquid %}
  <div class="hero-liquid-stage">
    <div class="hero-liquid-mount" data-react-island="glass-hero" aria-hidden="true"></div>
    <h1>{{ title }}</h1>
  </div>
  <script type="module" src="/assets/app-dist/app.js"></script>
  {%- else %}
  <h1>{{ title }}</h1>
  {%- endif %}
  {{ content | safe }}
</article>
{%- if projectFilter %}
<script src="/assets/js/card-tilt.js" defer></script>
<script src="/assets/js/project-filter.js" defer></script>
{%- endif %}
