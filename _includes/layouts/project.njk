---
layout: layouts/base.njk
---
{%- set projectNav = collections.projects | projectNav(lang, page.url) -%}
<article class="project">
  {%- if heroBackground %}
  <div class="hero-gradient" data-gradient="{{ heroColors | join(',') if heroColors else '' }}" aria-hidden="true"></div>
  <script src="/assets/js/gradient-bg.js" defer></script>
  {%- endif %}
  {%- if hero.scrollDriven %}
  <div class="scroll-stage" data-scroll-video>
    <div class="scroll-stage-sticky">
      <video poster="{{ hero.poster }}" preload="metadata" aria-label="{{ hero.alt }}">
        {%- if hero.srcMobile %}
        <source src="{{ hero.srcMobile }}" media="(max-width: 40rem)">
        {%- endif %}
        <source src="{{ hero.src }}">
      </video>
      <a href="#project-content" class="scroll-hint" aria-label="{{ ui.scrollHint }}">↓</a>
    </div>
  </div>
  <script src="/assets/js/scroll-video.js" defer></script>
  {%- elif hero %}
  <figure class="project-hero">
    {%- if hero.type == "video" %}
    <video src="{{ hero.src }}" poster="{{ hero.poster }}" controls preload="none" aria-label="{{ hero.alt }}"></video>
    {%- else %}
    {% image hero.src, hero.alt %}
    {%- endif %}
  </figure>
  {%- endif %}

  {%- if category %}
  <p class="project-meta-tag">{{ category }}{{ " — " + projectNav.index + "/" + projectNav.total if projectNav.total }}</p>
  {%- endif %}
  <h1 id="project-content">{{ title }}</h1>
  {%- if logos and logos.length %}
  <ul class="affiliation-logos">
    {%- for logo in logos %}
    <li><img src="/{{ logo.src }}" alt="{{ logo.alt }}" loading="lazy"></li>
    {%- endfor %}
  </ul>
  {%- endif %}
  {{ content | safe }}

  {%- if stats and stats.length %}
  <div class="stat-grid">
    {%- for stat in stats %}
    <div class="stat-item">
      <span class="stat-value">{{ stat.value }}</span>
      <span class="stat-label">{{ stat.label }}</span>
    </div>
    {%- endfor %}
  </div>
  {%- endif %}

  {%- include "partials/media-gallery.njk" %}
  {%- include "partials/download-list.njk" %}

  {%- if stlModels and stlModels.length %}
  <div class="stl-viewer-grid">
    {%- for model in stlModels %}
    {%- set parts = model.src if model.src is iterable and model.src is not string else [model.src] %}
    <div class="stl-viewer-mount" data-react-island="stl-viewer" data-stl-src="{{ parts | join('|') }}" data-stl-label="{{ model.label }}"></div>
    {%- endfor %}
  </div>
  <script type="module" src="/assets/app-dist/app.js"></script>
  {%- endif %}

  {%- if projectNav.prev or projectNav.next %}
  <nav class="project-pager" aria-label="{{ 'Navigation entre projets' if lang == 'fr' else 'Project navigation' }}">
    {%- if projectNav.prev %}
    <a href="{{ projectNav.prev.url }}" rel="prev" class="project-pager-link project-pager-prev">
      <span class="project-pager-arrow">←</span>
      <span class="project-pager-title">{{ projectNav.prev.data.title }}</span>
    </a>
    {%- else %}<span></span>{%- endif %}
    {%- if projectNav.next %}
    <a href="{{ projectNav.next.url }}" rel="next" class="project-pager-link project-pager-next">
      <span class="project-pager-title">{{ projectNav.next.data.title }}</span>
      <span class="project-pager-arrow">→</span>
    </a>
    {%- endif %}
  </nav>
  {%- endif %}

  {%- if cta %}
  <p class="project-cta"><a href="{{ cta.href }}" data-glass-cta>{{ cta.label }}</a></p>
  {%- endif %}
</article>
{%- if gallery and (gallery | selectattr("link") | list | length) %}
<script src="/assets/js/lightbox.js" defer></script>
{%- endif %}
